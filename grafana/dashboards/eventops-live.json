{
  "uid": "eventops-live",
  "title": "EventOps · Live telemetry (Timestream)",
  "description": "Kinesis -> Lambda -> Amazon Timestream. Near real time, one point per sensor reading.",
  "tags": [
    "eventops",
    "timestream"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "event",
        "label": "Event",
        "type": "query",
        "datasource": {
          "type": "grafana-timestream-datasource",
          "uid": "timestream"
        },
        "query": "SELECT DISTINCT event_id FROM $__database.$__table WHERE time > ago(2h) ORDER BY event_id",
        "definition": "SELECT DISTINCT event_id FROM $__database.$__table WHERE time > ago(2h) ORDER BY event_id",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "EventOps dashboards",
      "type": "dashboards",
      "tags": [
        "eventops"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Readings in range",
      "description": "Sensor readings stored in Timestream for the selected time range",
      "datasource": {
        "type": "grafana-timestream-datasource",
        "uid": "timestream"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-timestream-datasource",
            "uid": "timestream"
          },
          "rawQuery": "SELECT count(*) AS readings FROM $__database.$__table WHERE $__timeFilter",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C9A86A"
          },
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readings per second",
      "description": "Average over the last minute",
      "datasource": {
        "type": "grafana-timestream-datasource",
        "uid": "timestream"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-timestream-datasource",
            "uid": "timestream"
          },
          "rawQuery": "SELECT count(*) / 60.0 AS per_second FROM $__database.$__table WHERE time > ago(1m)",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C9A86A"
          },
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live events",
      "description": "Events with at least one reading in the last 2 minutes",
      "datasource": {
        "type": "grafana-timestream-datasource",
        "uid": "timestream"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-timestream-datasource",
            "uid": "timestream"
          },
          "rawQuery": "SELECT count(DISTINCT event_id) AS live FROM $__database.$__table WHERE time > ago(2m)",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#E8E2D6"
